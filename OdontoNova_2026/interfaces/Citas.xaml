<Window x:Class="OdontoNova.Citas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Estilos para los controles de la ventana de citas -->
        <Style x:Key="LabelCita" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1B5782"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <!-- diseño para mousehover del boton de regresar  -->
        <Style x:Key="BotonLimpio" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- animacion para boton de regresar -->
        <Style x:Key="AnimacionRegresar" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.25" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.25" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Animacion para el boton de guardar-->
        <Style x:Key="AnimacionGuardar" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Eefctos de clic para el boton de guardar-->
        <Style x:Key="BotonGuardarDiseñoPress" TargetType="Button">
            <Setter Property="Background" Value="#A8DDFE"/>
            <Setter Property="Foreground" Value="#1B5782"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="12" 
                        Padding="25,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7BB6DA"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2F80ED" Height="60" MouseDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource AnimacionRegresar}" Margin="10,0,0,0">
                    <Button Style="{StaticResource BotonLimpio}"  Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Click="btn_regresar_Click">
                        <Image Source="/Assets/Images/regresa.png" Stretch="Uniform" Width="40" />
                    </Button>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CITAS" Foreground="White" FontSize="35" FontFamily="Impact" Margin="0,0,8,0"/>
                    <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png" Width="45" Height="45" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="—" Width="36" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Click="Min_Click"/>
                    <Button Content="▭" Width="36" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Click="Max_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- Scroll para toda la ventana -->
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <!-- panel con efecto card del contenedor -->
                <StackPanel Margin="150,30,150,30">
                    <Border Background="White" CornerRadius="15" Padding="40" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.1" ShadowDepth="3"/>
                        </Border.Effect>
                        <!-- Contenedor de la info -->
                        <StackPanel>
                            <TextBlock Text="Agendar Nueva Cita" FontSize="32" Foreground="#216CA2" Margin="0,0,0,35" TextAlignment="Center" FontFamily="Impact">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#F9FAFB" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Margin="0,0,15,0"
                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="ID" 
                   Style="{StaticResource LabelCita}" 
                   FontSize="16" 
                   Margin="0,0,0,2" HorizontalAlignment="Center" Foreground="#FF050505"/>
                                        <TextBlock x:Name="txtb_idPaciente" 
                   Text="12345" 
                   Foreground="#FF4F5559" 
                   FontWeight="Bold" 
                   FontSize="18" 
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nombre del Paciente" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                    <Grid>
                                        <TextBox x:Name="txt_nombrePaciente" Padding="8" FontSize="18" Height="40" VerticalContentAlignment="Center" TextChanged="txt_nombrePaciente_TextChanged" KeyDown="txt_nombrePaciente_KeyDown" GotFocus="txt_nombrePaciente_GotFocus"/>
                                        <TextBlock x:Name="txtPlaceholderNombre" Text="Ej. Juan" Foreground="Gray" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Popup x:Name="popupSugerenciasNombre" PlacementTarget="{Binding ElementName=txt_nombrePaciente}" Placement="Bottom" StaysOpen="False">
                                            <ListBox x:Name="lbxSugerenciasNombre" MaxHeight="200" Width="300" MouseDoubleClick="lbxSugerenciasNombre_MouseClick" KeyDown="lbxSugerenciasNombre_KeyDown"/>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Apellido del Paciente" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                <Grid>
                                    <TextBox x:Name="txt_apellidoPaciente" Padding="8" FontSize="18" Height="40" VerticalContentAlignment="Center" TextChanged="txt_apellidoPaciente_TextChanged" KeyDown="txt_apellidoPaciente_KeyDown"/>
                                    <TextBlock x:Name="txtPlaceholderApellido" Text="Ej. Pérez" Foreground="Gray" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Popup x:Name="popupSugerenciasApellido" PlacementTarget="{Binding ElementName=txt_apellidoPaciente}" Placement="Bottom" StaysOpen="False">
                                        <ListBox x:Name="lbxSugerenciasApellido" MaxHeight="200" Width="300" MouseDoubleClick="lbxSugerenciasApellido_MouseClick" KeyDown="lbxSugerenciasApellido_KeyDown"/>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Tratamiento" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                    <Border x:Name="borderTratamiento" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                        <ComboBox x:Name="cb_tratamiento" Height="38" FontSize="18" BorderThickness="0" VerticalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Dentista Asignado" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                    <Border x:Name="borderDentistaCita" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                        <ComboBox x:Name="cb_dentistaCita" Height="38" FontSize="18" BorderThickness="0" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Dr. Lara"/>
                                            <ComboBoxItem Content="Dr. General"/>
                                        </ComboBox>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Fecha de Cita" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                    <DatePicker x:Name="dp_fechaCita" Height="40" FontSize="18" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Hora" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                    <Border x:Name="borderHoraCita" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                        <ComboBox x:Name="cb_horaCita" Height="38" FontSize="18" BorderThickness="0" VerticalContentAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Observaciones Adicionales" Style="{StaticResource LabelCita}" Foreground="#1B5782"/>
                                <TextBox x:Name="txt_observaciones" Height="80" FontSize="16" Padding="8" BorderBrush="#CBD5E1" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>

                            <Border Style="{StaticResource AnimacionGuardar}" CornerRadius="12" Background="#276DCF" HorizontalAlignment="Center">
                                <Button x:Name="btn_guardarCita"  Style="{StaticResource BotonGuardarDiseñoPress}" Click="btn_guardarCita_Click" Content="Guardar Cita" Width="200" Height="50" Background="Transparent" Foreground="White" BorderBrush="Transparent" Cursor="Hand" FontFamily="Impact" FontSize="18"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="OverlayCita" Background="#AA000000" Visibility="Collapsed" MouseLeftButtonDown="btn_volverEditar_Click"/>

            <!-- panel con resumen de la cita -->
            <Border x:Name="pnlResumenFlotante" Visibility="Collapsed" Width="450" MaxHeight="700" HorizontalAlignment="Center" Background="White" CornerRadius="20" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Opacity="0.4" ShadowDepth="0"/>
                </Border.Effect>
                <Grid Margin="35">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="RESUMEN FINAL" FontSize="26" FontFamily="Impact" Foreground="#276DCF" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="PACIENTE" Foreground="#1B5782" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="res_Nombre" FontSize="17" Margin="0,0,0,15" Foreground="Black" TextWrapping="Wrap"/>

                            <TextBlock Text="TRATAMIENTO" Foreground="#1B5782" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="res_Tratamiento" FontSize="17" Margin="0,0,0,15" Foreground="Black"/>

                            <TextBlock Text="FECHA Y HORA" Foreground="#1B5782" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="res_FechaHora" FontSize="17" Margin="0,0,0,15" Foreground="Black"/>

                            <TextBlock Text="DENTISTA" Foreground="#1B5782" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="res_Dentista" FontSize="17" Margin="0,0,0,15" Foreground="Black"/>

                            <TextBlock Text="OBSERVACIONES" Foreground="#1B5782" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="res_Observaciones" FontSize="15" Foreground="Black" TextWrapping="Wrap" FontStyle="Italic"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- botones para confirma cita o para volver a editar-->
                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource AnimacionGuardar}" Background="#219653" CornerRadius="12" Margin="0,0,0,15">
                            <Button  Content="CONFIRMAR CITA" Style="{StaticResource BotonGuardarDiseñoPress}"  Height="55" Background="Transparent" BorderThickness="0" Foreground="White" FontWeight="Bold" FontSize="18" Click="btn_confirmarFinal_Click"/>
                        </Border>
                        <Button Content="← Volver a editar datos" Background="Transparent" BorderThickness="0" Foreground="#276DCF" FontSize="16" Cursor="Hand" Click="btn_volverEditar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

