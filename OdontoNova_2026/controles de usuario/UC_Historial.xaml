<UserControl x:Class="OdontoNovaWPF_FIS.UC_Historial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="98">

    <UserControl.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#F0FAFF"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2ECC71"/>
        <QuadraticEase x:Key="SmoothEase" EasingMode="EaseOut"/>

        <!-- Sombra -->
        <DropShadowEffect x:Key="SoftShadow"
                          Color="#000"
                          BlurRadius="6"
                          ShadowDepth="1"
                          Opacity="0.15"/>

        <!-- Botón moderno pequeño -->
        <Style TargetType="Button" x:Key="ModernButtonSmall">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Card principal -->
    <Border x:Name="CardBorder"
            Background="{StaticResource CardBrush}"
            CornerRadius="10"
            Padding="8"
            Margin="2"
            HorizontalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5"
            BorderThickness="2"
            BorderBrush="#00A0A0A0"
            Effect="{StaticResource SoftShadow}">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ID Cita -->
            <TextBlock x:Name="lb_idCita"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="{StaticResource TextDarkBrush}"
                       Text="ID"/>

            <!-- Fecha y hora -->
            <TextBlock x:Name="lb_fechaYHora"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="13"
                       Text="Fecha y hora"/>

            <!-- Estado -->
            <TextBlock x:Name="lb_estadoCita"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="13"
                       Text="Estado"/>

            <!-- Tratamiento -->
            <TextBlock x:Name="lb_tratamiento"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="13"
                       Text="Tratamiento"/>

            <!-- Monto cita -->
            <TextBlock x:Name="lb_montoCita"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="13"
                       Text="Monto"/>

            <!-- Monto extra -->
            <TextBlock x:Name="lb_montoExtra"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="DimGray"
                       FontSize="13"
                       Text="Monto extra"/>

            <!-- Botón editar -->
            <Button x:Name="Btn_EditarCita"
                    Grid.Column="6"
                    Width="45" Height="45"
                    Background="LightSeaGreen"
                    BorderThickness="0"
                    ToolTip="Editar cita"
                    Style="{StaticResource ModernButtonSmall}"
                    Click="Btn_EditarCita_Click">
                <Image Source="/Assets/Images/EditExp.png" Stretch="Uniform"/>
            </Button>
        </Grid>
    </Border>

    <!-- Hover Animations -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="{Binding Color, Source={StaticResource CardHoverBrush}}"
                                    Duration="0:0:0.2"
                                    EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1.02" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1.02" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource SmoothEase}"/>
                    <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#4A90E2"
                                    Duration="0:0:0.2"
                                    EasingFunction="{StaticResource SmoothEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>

        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="{Binding Color, Source={StaticResource CardBrush}}"
                                    Duration="0:0:0.2"
                                    EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource SmoothEase}"/>
                    <ColorAnimation Storyboard.TargetName="CardBorder"
                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                    To="#00A0A0A0"
                                    Duration="0:0:0.2"
                                    EasingFunction="{StaticResource SmoothEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>


