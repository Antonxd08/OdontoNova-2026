<UserControl x:Class="OdontoNovaWPF_FIS.UC_Historial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="90">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#F0FAFF"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#1F1F1F"/>
        <QuadraticEase x:Key="SmoothEase" EasingMode="EaseOut"/>

        <DropShadowEffect x:Key="SoftShadow"
                          Color="#000"
                          BlurRadius="10"
                          ShadowDepth="1"
                          Opacity="0.08"/>

        <Style x:Key="BotonLimpioUC" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Background="{StaticResource CardBrush}"
            CornerRadius="12"
            Padding="10,5"
            Margin="5,4"
            HorizontalAlignment="Stretch"
            RenderTransformOrigin="0.5,0.5"
            BorderThickness="1"
            BorderBrush="#E2E8F0"
            Effect="{StaticResource SoftShadow}">

        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lb_idCita" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Text="id"/>

            <TextBlock x:Name="lb_fechaYHora" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="14" Text="Fecha y hora"/>

            <TextBlock x:Name="lb_estadoCita" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="14" Text="estado"/>

            <TextBlock x:Name="lb_tratamiento" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="14" Text="Ajuste"/>

            <TextBlock x:Name="lb_montoCita" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="14" Text="$0.00"/>

            <TextBlock x:Name="lb_montoExtra" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="14" Text="$0.00"/>

            <!-- Botón para ver observaciones-->
            <Button x:Name="Btn_VerObservaciones"
                    Grid.Column="6"
                    Width="35" Height="35"
                    Background="#E2E8F0"
                    ToolTip="Ver observaciones detalladas"
                    Style="{StaticResource BotonLimpioUC}">
                <TextBlock Text="✏️" FontSize="16" Margin="0,0,2,0"/>
            </Button>

            <Button x:Name="Btn_EditarCita"
                    Grid.Column="7"
                    Width="45" Height="40"
                    Background="#2ECC71"
                    ToolTip="Editar esta cita"
                    Style="{StaticResource BotonLimpioUC}"
                    Click="Btn_EditarCita_Click">
                <Image Source="/Assets/Images/EditExp.png" Stretch="Uniform" Margin="5"/>
            </Button>
        </Grid>
    </Border>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{Binding Color, Source={StaticResource CardHoverBrush}}" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.01" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.01" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                    <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#1B5782" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="{Binding Color, Source={StaticResource CardBrush}}" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                    <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                    <ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E2E8F0" Duration="0:0:0.15" EasingFunction="{StaticResource SmoothEase}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>


