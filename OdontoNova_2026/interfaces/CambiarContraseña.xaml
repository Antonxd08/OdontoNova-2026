<Window x:Class="SistemaOdontonova.Interfaces.CambiarContraseña"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SistemaOdontonova.Interfaces"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="420" Height="480"
        MouseLeftButtonDown="CambiarContraseña_MouseLeftButtonDown">

    <!-- convertir true/false a visible/collapsed para ocultar o mostrar elementos. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DropShadowEffect x:Key="DropShadow" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
    </Window.Resources>

    <Border CornerRadius="20" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <!-- BTON DE CERRAR -->
            <Button x:Name="Btn_Cerrar" Content="✕" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,10,10,0"
                    Background="Transparent" Foreground="Black"
                    BorderThickness="0" FontSize="16"
                    Cursor="Hand" Click="Btn_Cerrar_Click" ToolTip="Cerrar"/>

            <StackPanel VerticalAlignment="Center" Margin="40,40,40,40">
                <!-- LOGO -->
                <Image Source="/Imagenes/Logo_Blanco_Solo.png"
                   Width="100" Height="100"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
                <!-- Indicador de pasos -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12
                            ">
                    <Ellipse x:Name="Punto1" Width="14" Height="14" Fill="#FF0B8AA2"/>
                    <Rectangle x:Name="Barra1" Width="50" Height="2" Fill="#FF707171" Margin="5,0"/>
                    <Ellipse x:Name="Punto2" Width="14" Height="14" Fill="#FF9E9E9E"/>
                    <Rectangle x:Name="Barra2" Width="50" Height="2" Fill="#FF707171" Margin="5,0"/>
                    <Ellipse x:Name="Punto3" Width="14" Height="14" Fill="#FF9E9E9E"/>
                </StackPanel>

                <!-- ======= CONTENIDO DE LOS PASOS ======== -->
                <Grid x:Name="GridPasos">
                    <!-- Paso 1 -->
                    <Grid x:Name="Paso1" Opacity="1">
                        <StackPanel>
                            <TextBlock Text="Verifica tu correo electrónico"
                                       FontSize="18" FontFamily="Ebrima" FontWeight="SemiBold"
                                       TextAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Ingresa tu correo para enviar un código de recuperación."
                                       Foreground="#777" TextAlignment="Center" Margin="0,0,0,20"/>

                            <Grid>
                                <TextBox x:Name="Txt_CorreoElectronico"
                                         Height="40" FontSize="15" Padding="10"
                                         BorderBrush="#CCC" BorderThickness="1" Background="#FFF1F1F1"/>
                                <TextBlock Text="Correo electrónico"
                                           Foreground="#FF878787" FontSize="14"
                                           Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text.IsEmpty, ElementName=Txt_CorreoElectronico, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>

                            <Button x:Name="Btn_EnviarCodigo" Content="Enviar código"
                                    Margin="0,25,0,0" Height="40" FontSize="12"
                                    Background="#0078D7" Foreground="White"
                                    FontWeight="Bold" FontFamily="Lucida Sans Unicode"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="Btn_EnviarCodigo_Click" Width="190">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#0078D7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF3273E7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#33000000" BlurRadius="6" ShadowDepth="1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Paso 2 -->
                    <Grid x:Name="Paso2" Visibility="Collapsed" Opacity="0">
                        <StackPanel>
                            <TextBlock Text="Introduce el token de verificación"
                                       FontSize="18" FontFamily="Ebrima" FontWeight="SemiBold"
                                       TextAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Revisa tu correo e ingresa el token recibido."
                                       Foreground="#777" TextAlignment="Center" Margin="0,0,0,10"/>
                            <Grid>
                                <TextBox x:Name="Txt_tokenEnviado"
                                         Height="40" FontSize="14" Padding="10" BorderBrush="#CCC"
                                         BorderThickness="1" Background="#FFF1F1F1"/>
                                <TextBlock Text="Código de verificación"
                                           Foreground="#FF878787" FontSize="14" Margin="15,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Text.IsEmpty, ElementName=Txt_tokenEnviado, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>

                            <TextBlock x:Name="Lb_temporizador"
                                       Text="Expira en 05:00" Foreground="#E53935"
                                       FontWeight="Bold" TextAlignment="Center" Margin="0,10,0,20"/>

                            <Button x:Name="Btn_ReenviarToken" Click="Btn_ReenviarToken_Click"
                            Content="Reenviar código"
                            Height="35" Width="160"
                            Background="#41D4DB"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="12"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#0078D7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#33000000" BlurRadius="0" ShadowDepth="0"/>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>

                                            <!-- Hover -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF3273E7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#33000000" BlurRadius="6" ShadowDepth="1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                            <!-- Click (Pressed) -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#005BB5"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#22000000" BlurRadius="3" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>

                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>



                            <Button x:Name="Btn_VerificarToken" Content="Verificar Token"
                                    Height="40" Background="#0078D7" Foreground="White" FontSize="12"
                                    FontWeight="Bold" FontFamily="Lucida Sans Unicode" Width="200"
                                    BorderThickness="0" Cursor="Hand" Click="Btn_VerificarToken_Click" Margin="0,0,0,20">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#0078D7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF3273E7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#33000000" BlurRadius="6" ShadowDepth="1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Paso 3 -->
                    <Grid x:Name="Paso3" Visibility="Collapsed" Opacity="0">
                        <StackPanel HorizontalAlignment="Center" Width="280">
                            <TextBlock Text="Cambia tu contraseña"
                                       FontSize="18" FontFamily="Ebrima"
                                       FontWeight="SemiBold" Foreground="#333"
                                       TextAlignment="Center" Margin="0,0,0,12"/>

                            <!-- NUEVA CONTRASEÑA -->
                            <StackPanel>
                                <TextBlock Text="Nueva contraseña"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#555" Margin="2,0,0,4"/>

                                <Grid>
                                    <PasswordBox x:Name="Psw_Contraseñanueva"
                                                 Height="34" FontSize="13" Padding="10,0,35,0"
                                                 BorderBrush="#D0D0D0" BorderThickness="1" Background="#F8F8F8"
                                                 Visibility="Visible" VerticalContentAlignment="Center"/>

                                    <TextBox x:Name="Txt_ContraseñaNueva"
                                             Height="34" FontSize="13" Padding="10,0,35,0"
                                             BorderBrush="#D0D0D0" BorderThickness="1" Background="#F8F8F8"
                                             Visibility="Collapsed" VerticalContentAlignment="Center"/>

                                    <Button x:Name="Btn_MostrarContraseña"
                                            Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,5,0"  Background="Transparent" BorderThickness="0" Foreground="#666"  
                                            FontSize="14" Content="👁" Cursor="Hand" Click="Btn_MostrarContraseña_Click"/>
                                </Grid>

                                <!-- Barra de seguridad -->
                                <StackPanel Margin="0,6,0,0">
                                    <Border CornerRadius="6" Background="#EEE" Height="10" Effect="{StaticResource DropShadow}">
                                        <ProgressBar x:Name="PgBar_seguridad"
                                                     Height="10" Minimum="0" Maximum="100" Value="0"
                                                     BorderThickness="0" Background="Transparent">
                                            <ProgressBar.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF6B6B" Offset="0"/>
                                                    <GradientStop Color="#FFD93D" Offset="0.5"/>
                                                    <GradientStop Color="#00C48C" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ProgressBar.Foreground>

                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                                                    <Grid>
                                                                        <Rectangle x:Name="PART_Track" RadiusX="6" RadiusY="6" Fill="#E0E0E0"/>
                                                                        <Rectangle x:Name="PART_Indicator" RadiusX="6" RadiusY="6" Fill="{TemplateBinding Foreground}" Width="0"/>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </Border>

                                    <!-- Info barra -->
                                    <TextBlock x:Name="Lb_textoBarraContra"
                                               Text="Seguridad: "
                                               FontSize="11" Foreground="#666"
                                               Margin="2,4,0,0" FontFamily="Leelawadee UI"/>
                                </StackPanel>


                            </StackPanel>

                            <!-- CONFIRMAR CONTRASEÑA -->
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Confirmar contraseña"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,4"/>

                                <Grid>
                                    <PasswordBox x:Name="Psw_Confirmarcontraseña"
                                                 Height="34" FontSize="13" Padding="10,0,35,0"
                                                 BorderBrush="#D0D0D0" BorderThickness="1"
                                                 Background="#F8F8F8" VerticalContentAlignment="Center"/>

                                    <TextBox x:Name="Txt_Confirmarcontraseña"
                                             Height="34" FontSize="13" Padding="10,0,35,0"
                                             BorderBrush="#D0D0D0" BorderThickness="1"
                                             Background="#F8F8F8" Visibility="Collapsed" VerticalContentAlignment="Center"/>

                                    <Button x:Name="Btn_MostrarContraseña2"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,5,0" Background="Transparent" BorderThickness="0" Foreground="#666"
                                            FontSize="14" Content="👁" Cursor="Hand" Click="Btn_MostrarContraseña2_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- BOTN ACTUALIZAR -->
                            <Button x:Name="Btn_ActualizarContra" Content="Actualizar contraseña"
                                    Margin="0,18,0,0" Height="40" Width="200"
                                    Background="#0078D7" Foreground="White"
                                    FontWeight="Bold" FontSize="12" FontFamily="Lucida Sans Unicode"
                                    BorderThickness="0" Cursor="Hand" Click="Btn_ActualizarContra_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#00C1BB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3273E7"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#33000000" BlurRadius="6" ShadowDepth="1"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>