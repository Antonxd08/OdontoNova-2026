<Window x:Class="OdontoNova.MenuDoctor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OdontoNova"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White" Loaded="Window_Loaded">

    <!-- Animacion de botones -->
    <Window.Resources>
        <Style x:Key="BotonHoverAnimado" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Encabezado -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <Border Background="#00729C" Height="25" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Content="—" Width="36" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand" Click="Min_Click"/>
                        <Button Content="▭" Width="36" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand" Click="Max_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#FFFFFF" Padding="10,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Logo -->
                        <ColumnDefinition Width="*"/>
                        <!-- OdontoNova -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Foto + nombre -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Fecha y hora -->
                    </Grid.ColumnDefinitions>

                    <!-- LOGO -->
                    <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png"
Width="200" Height="200"
Margin="10"
Grid.Column="0"
VerticalAlignment="Top"/>

                    <!-- Título -->
                    <TextBlock Text="OdontoNova"
    FontSize="80"
    FontWeight="Bold"
    Foreground="#216CA2"
    Margin="60,10,10,10"
    FontFamily="Impact"
    VerticalAlignment="Center"
    Grid.Column="1"
    TextWrapping="Wrap"/>

                    <!-- FOTO + NOMBRE DEL USUARIO -->
                    <StackPanel Grid.Column="2"
     Orientation="Horizontal"
     VerticalAlignment="Center"
     Margin="0,0,25,0">

                        <Border Width="70" Height="70" CornerRadius="35"
     BorderBrush="#216CA2" BorderThickness="2"
     Background="#EEE" Margin="0,0,10,0">
                            <Image x:Name="imgUsuarioMenu"
        Width="70" Height="70"
        Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock x:Name="txtNombreUsuarioMenu"
        Text="Usuario"
        VerticalAlignment="Center"
        FontSize="22"
        Foreground="#216CA2"
        FontFamily="Tahoma"
        FontWeight="Bold"/>
                    </StackPanel>

                    <!-- FECHA + HORA -->
                    <StackPanel Grid.Column="3"
     VerticalAlignment="Center"
     Margin="20,0,10,0"
     Orientation="Vertical">

                        <!-- Fecha -->
                        <TextBlock x:Name="txtb_fecha"
        Text="Lunes 06 de octubre del 2025"
        FontSize="16"
        Foreground="#216CA2"
        FontFamily="Impact"
        Margin="0,0,0,5"
        HorizontalAlignment="Center"/>

                        <!-- Hora -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="txtb_hora"
            Text="00"
            FontSize="16"
            Foreground="#216CA2"
            FontFamily="Impact"/>
                            <TextBlock Text=":" FontSize="16" Foreground="#216CA2" FontFamily="Impact"/>
                            <TextBlock x:Name="txtb_minutos"
            Text="00"
            FontSize="16"
            Foreground="#216CA2"
            FontFamily="Impact"/>
                            <TextBlock Text=":" FontSize="16" Foreground="#216CA2" FontFamily="Impact"/>
                            <TextBlock x:Name="txtb_segundos"
            Text="00"
            FontSize="16"
            Foreground="#216CA2"
            FontFamily="Impact"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#00729C" Height="8"/>
        </StackPanel>

        <!-- Contenedor principal con scroll-->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Background="#00729C">


                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button x:Name="btn_registrarCitas"
                                Background="Transparent" BorderThickness="0"
                                Margin="20,5,20,15" Cursor="Hand" Click="btn_registrarCita_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Images/dato-de-registro.png" Width="64" Height="64" Margin="0,0,10,0"/>
                                <TextBlock Text="Registrar cita" Foreground="White" FontSize="18" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button x:Name="btn_buscarExpediente"
                                Background="Transparent" BorderThickness="0"
                                Margin="20,5,20,15" Cursor="Hand" Click="btn_buscarExpediente_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Images/archivo.png" Width="54" Height="54" Margin="0,0,10,0"/>
                                <TextBlock Text="Buscar expediente" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="0,10,0,15" FontWeight="Bold" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button x:Name="btn_verCalendario" Click="btn_verCalendario_Click"
                                Background="Transparent" BorderThickness="0"
                                Margin="20,5,20,15" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                                <Image Source="/Assets/Images/calendario.png" Width="54" Height="54" Margin="0,0,10,0"/>
                                <TextBlock Text="Ver calendario" Foreground="White" FontSize="18" VerticalAlignment="Center" FontFamily="Tahoma" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button x:Name="btn_generarReportes"
             Background="Transparent" BorderThickness="0"
             Margin="20,20,20,25" Cursor="Hand" Click="btn_generarReportes_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Images/informe.png" Width="54" Height="54" Margin="0,0,10,0"/>
                                <TextBlock Text="Reportes Citas" Foreground="White" FontSize="18" VerticalAlignment="Center" FontFamily="Tahoma" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button x:Name="btn_verPerfil" Click="btn_verPerfil_Click"
                                Background="Transparent" BorderThickness="0"
                                Margin="20,5,20,15" Cursor="Hand" FontWeight="Bold" FontSize="18" FontFamily="Tahoma">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Images/usuario (1).png" Width="54" Height="54" Margin="0,0,10,0"/>
                                <TextBlock Text="Ver perfil" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button x:Name="btn_cerrarSesion"
                                Background="Transparent" BorderThickness="0"
                                Margin="20,5,20,20" Cursor="Hand" Click="btn_cerrarSesion_Click">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Image Source="/Assets/Images/cerrar-sesion.png" Width="54" Height="54" Margin="0,0,10,0"/>
                                <TextBlock Text="Cerrar sesión" Foreground="White" FontSize="18" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource BotonHoverAnimado}">
                        <Button Background="Transparent" BorderThickness="0" Margin="20,5,20,15" Cursor="Hand" HorizontalAlignment="Right" Click="btn_AcercaDe_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="btn_acercaDe" Source="/Assets/Images/acerca-de.png" Width="54" Height="54" Margin="0,0,10,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                </StackPanel>


                <StackPanel Grid.Column="1" Margin="80,0,40,20">
                    <TextBlock Text="Citas agendadas"
                               FontSize="28" Foreground="#000000"
                               Height="59" HorizontalAlignment="Center"
                               FontFamily="Impact" Margin="0,30,0,20"/>

                    <Border
                        CornerRadius="8,8,0,0"
                        Padding="30,10,10,10"
                        Background="#F3F4F6"
                        BorderThickness="1,1,1,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Hora" Foreground="Black" Margin="0,0,20,0" FontFamily="Tahoma" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Nombre del paciente" Foreground="Black" Margin="150,0,0,0" HorizontalAlignment="Center" FontFamily="Tahoma" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Tratamiento" Foreground="Black" Margin="150,0,0,0" FontWeight="Bold" FontFamily="Tahoma"/>
                        </Grid>
                    </Border>

                    <Border x:Name="br_contenedorCitas"
                        Background="#F3F4F6"
                        CornerRadius="0,0,8,8"
                        Padding="10,0,10,10"
                        BorderThickness="1,0,1,1"
                        Height="435">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="5,5,5,5">
                            <StackPanel x:Name="st_contenedorCitas" Orientation="Vertical">
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>