<UserControl x:Class="OdontoNovaWPF_FIS.UC_Expediente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="70">

    <UserControl.Resources>

        <!-- Colores -->
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2ECC71"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3CDE82"/>
        <QuadraticEase x:Key="SmoothEase" EasingMode="EaseOut"/>

        <!-- Sombra -->
        <DropShadowEffect x:Key="SoftShadow"
                          Color="#000"
                          BlurRadius="8"
                          ShadowDepth="1"
                          Opacity="0.15"/>

        <!-- Botón moderno estilo reutilizable -->
        <Style TargetType="Button" x:Key="ModernButtonSmall">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- Card principal -->
    <Border CornerRadius="10"
            Background="{StaticResource CardBrush}"
            Padding="5"
            Effect="{StaticResource SoftShadow}"
            BorderThickness="2"
            BorderBrush="#00A0A0A0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.01" Duration="0:0:0.25"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.01" Duration="0:0:0.25"
                                                     EasingFunction="{StaticResource SmoothEase}"/>
                                    <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)"
                                                    To="#4A90E2" Duration="0:0:0.25"
                                                    EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.25"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.25"/>
                                    <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)"
                                                    To="#00A0A0A0" Duration="0:0:0.25"
                                                    EasingFunction="{StaticResource SmoothEase}"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <!-- Contenido del card -->
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ID -->
            <TextBlock x:Name="lb_idExpediente"
                       Grid.Column="0"
                       Text="ID"
                       FontWeight="Bold"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextDarkBrush}"/>

            <!-- Foto -->
            <Ellipse x:Name="FotoPacienteEllipse" Grid.Column="1" Width="50" Height="50" Stroke="Turquoise" StrokeThickness="2"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="/Assets/Images/user_456212.png"/>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Nombre -->
            <TextBlock x:Name="lb_NombrePaciente"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="Nombre(s)" />

            <!-- Apellido -->
            <TextBlock x:Name="lb_ApellidoPaciente"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="Apellido" />

            <!-- Teléfono -->
            <TextBlock x:Name="lb_TelefonoPaciente"
                       Grid.Column="4"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="Teléfono" />

            <!-- Fecha Registro -->
            <TextBlock x:Name="lb_FechaRegistro"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       Foreground="DimGray"
                       Text="Fecha registro" />

            <!-- Activo -->
            <Image x:Name="pbx_activo"
                   Grid.Column="6"
                   Width="25" Height="25"
                   VerticalAlignment="Center"
                   Source="/Assets/Images/banderaActivo.png"/>

            <!-- Botones -->
            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" >
                <Button x:Name="Btn_EditarExpediente"
                        Width="30" Height="30"
                        Style="{StaticResource ModernButtonSmall}"
                        Background="LightSeaGreen"
                        Margin="0,0,5,0"
                        Click="Btn_EditarExpediente_Click">
                    <Image Source="/Assets/Images/EditExp.png"/>
                </Button>

                <Button x:Name="Btn_VerExpediente"
                        Width="30" Height="30"
                        Style="{StaticResource ModernButtonSmall}"
                        Background="#FF0841"
                        Margin="0,0,5,0"
                        Click="Btn_VerExpediente_Click">
                    <Image Source="/Assets/Images/VerExp.png"/>
                </Button>

                <Button x:Name="Btn_VerHistorial"
                        Width="30" Height="30"
                        Style="{StaticResource ModernButtonSmall}"
                        Background="Black"
                        Click="Btn_VerHistorial_Click">
                    <Image Source="/Assets/Images/VerHisoriall.png"/>
                </Button>
            </StackPanel>
        </Grid>

    </Border>
</UserControl>


