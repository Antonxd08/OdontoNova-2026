<UserControl x:Class="OdontoNovaWPF_FIS.UC_Citas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="131">

    <UserControl.Resources>

        <!-- 🎨 PALETA DE COLORES -->
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2ECC71"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3CDE82"/>

        <!-- 🎬 Easing para animaciones -->
        <QuadraticEase x:Key="SmoothEase" EasingMode="EaseOut"/>

        <!-- SOMBRA SUAVE -->
        <DropShadowEffect x:Key="SoftShadow"
                          Color="#000"
                          BlurRadius="10"
                          ShadowDepth="1"
                          Opacity="0.15"/>

        <!-- ===================== -->
        <!-- 🟦 CARD STYLE -->
        <!-- ===================== -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#00A0A0A0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>

                                <!-- Escala suave -->
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.01"
                                                 Duration="0:0:0.25"
                                                 EasingFunction="{StaticResource SmoothEase}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.01"
                                                 Duration="0:0:0.25"
                                                 EasingFunction="{StaticResource SmoothEase}"/>

                                <!-- Opacidad sutil -->
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0.97"
                                                 Duration="0:0:0.25"/>

                                <!-- ⭐ Borde iluminado -->
                                <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)"
                                                To="#4A90E2"
                                                Duration="0:0:0.25"
                                                EasingFunction="{StaticResource SmoothEase}"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.25"/>

                                <ColorAnimation Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)"
                                                To="#00A0A0A0"
                                                Duration="0:0:0.25"
                                                EasingFunction="{StaticResource SmoothEase}"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>

                </Trigger>

            </Style.Triggers>
        </Style>

        <!-- ===================== -->
        <!-- 🟩 BOTÓN MODERNO -->
        <!-- ===================== -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Grid ClipToBounds="True">

                            <!-- Ripple discreto -->
                            <Ellipse x:Name="Ripple"
                                     Fill="#30FFFFFF"
                                     Width="0" Height="0"
                                     Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- Hover suave -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>

                            <!-- Presionar + ripple -->
                            <Trigger Property="IsPressed" Value="True">

                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>

                                            <DoubleAnimation Storyboard.TargetName="Ripple"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.35" Duration="0:0:0.12"/>

                                            <DoubleAnimation Storyboard.TargetName="Ripple"
                                                             Storyboard.TargetProperty="Width"
                                                             To="180" Duration="0:0:0.35"
                                                             EasingFunction="{StaticResource SmoothEase}"/>
                                            <DoubleAnimation Storyboard.TargetName="Ripple"
                                                             Storyboard.TargetProperty="Height"
                                                             To="180" Duration="0:0:0.35"
                                                             EasingFunction="{StaticResource SmoothEase}"/>

                                            <DoubleAnimation Storyboard.TargetName="Ripple"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.40"
                                                             BeginTime="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>

                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <!-- ===================== -->
    <!-- 🧩 INTERFAZ PRINCIPAL -->
    <!-- ===================== -->
    <Border Style="{StaticResource CardStyle}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32.21289*"/>
                <ColumnDefinition Width="67.78712*"/>
                <ColumnDefinition Width="195"/>
                <ColumnDefinition Width="229"/>
            </Grid.ColumnDefinitions>

            <!-- Hora -->
            <TextBlock x:Name="lb_horaCita"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       Foreground="{StaticResource TextDarkBrush}"/>

            <!-- Paciente -->
            <TextBlock x:Name="lb_nombrePaciente"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       Foreground="{StaticResource TextDarkBrush}"/>

            <!-- Tratamiento -->
            <TextBlock x:Name="lb_tratamiento"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       Foreground="{StaticResource TextDarkBrush}"/>

            <!-- Botón -->
            <Button x:Name="btnConfirmarPago_pagar"
                    Grid.Column="3"
                    Width="204" Height="50"
                    Style="{StaticResource ModernButton}"
                    Content="Confirmar asistencia y pagar"
                    Click="btnConfirmarPago_pagar_Click"/>

        </Grid>

    </Border>

</UserControl>




