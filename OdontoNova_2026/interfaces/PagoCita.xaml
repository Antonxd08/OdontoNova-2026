<Window x:Class="OdontoNova.PagoCita"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pago de Cita" Height="330" Width="460" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5" WindowStyle="None">

    <Window.Resources>
        <!-- Sombras -->
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.18"/>
        <DropShadowEffect x:Key="ButtonShadow" Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.25"/>

        <!-- Botón animado -->
        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Background" Value="#43A047"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="8"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnBorder"
                                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#388E3C"/>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Borde general de la ventana -->
    <Border Background="White" CornerRadius="12" BorderBrush="#B0BEC5" BorderThickness="2" Margin="5" 
            Effect="{StaticResource CardShadow}">
        <Grid>
            <!-- Barra superior tipo sistema -->
            <Border Background="#1E88E5" Height="32" VerticalAlignment="Top" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Button Content="X"
                            Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,6,0"
                            Background="#1E88E5" Foreground="White"
                            FontWeight="Bold" BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>

            <!-- Contenido desplazado -->
            <Grid Margin="20,40,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Border Grid.Row="0" Background="#1E88E5" CornerRadius="10" Padding="12,10" Margin="0,0,0,0">
                    <DockPanel>
                        <TextBlock Text="Pago de la Cita" DockPanel.Dock="Left" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="ID:" Margin="20,0,0,0" FontSize="16" Foreground="White"/>
                        <TextBlock x:Name="lb_idCita" Margin="5,0,0,0" FontSize="16" Foreground="White"/>
                    </DockPanel>
                </Border>

                <!-- Monto principal -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Monto de la cita:" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <TextBox x:Name="txt_Monto" Grid.Column="1" Width="140" Height="26" Background="#FAFAFA"
                                 BorderBrush="#B0BEC5" BorderThickness="1" Padding="4" FontSize="14" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- Monto extra -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="chk_Extra" VerticalAlignment="Center" Checked="chk_Extra_Changed" Unchecked="chk_Extra_Changed"/>
                            <TextBlock Text="➕" FontSize="14" Margin="6,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Agregar monto extra" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monto extra:" VerticalAlignment="Center" FontSize="15"/>
                            <TextBox x:Name="txt_MontoExtra" Grid.Column="1" Width="140" Height="26" Background="#FAFAFA"
                                     BorderBrush="#B0BEC5" BorderThickness="1" Padding="4" FontSize="14" IsEnabled="False"
                                     Opacity="0.4" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Botón confirmar -->
                <Button Grid.Row="3" x:Name="btn_ConfirmarPago" Content="Confirmar Pago"
                        Style="{StaticResource AnimatedButton}" Margin="0,12,0,0"
                        Click="btn_ConfirmarPago_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>







