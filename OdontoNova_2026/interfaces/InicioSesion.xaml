<Window x:Class="OdontoNova.InicioSesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OdontoNova"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White"
        mc:Ignorable="d">

    <!-- ESTILOS -->
    <Window.Resources>
        <Style x:Key="BotonHoverAnimado" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.08" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.08" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Encabezado -->
                <RowDefinition Height="*"/>
                <!-- Contenido -->
            </Grid.RowDefinitions>

            <!-- ENCABEZADO SUPERIOR -->
            <Border Grid.Row="0" Background="#2F80ED" Height="25" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="0,0,8,0">
                        <Button Content="—" Width="36" Height="30"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" FontSize="14"
                                Cursor="Hand" Click="Min_Click"/>
                        <Button Content="▭" Width="36" Height="30"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" FontSize="14"
                                Cursor="Hand" Click="Max_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO CON SCROLL -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!-- PANEL IZQUIERDO -->
                    <Grid Background="#2F80ED" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <!-- BOTÓN DE REGRESO CON EFECTO -->
                        <Border Style="{StaticResource BotonHoverAnimado}">
                            <Button Grid.Row="0" Width="60" Height="60"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"
                                    Click="btn_regresar_Click"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="10">
                                <Image x:Name="btn_regresar" Source="/Assets/Images/regresa.png" Stretch="Uniform"/>
                            </Button>
                        </Border>

                        <!-- CONTENIDO CENTRAL -->
                        <StackPanel Grid.Row="1" >
                            <TextBlock Text="¡BIENVENIDO!" 
                                       FontSize="62" FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       Margin="0,80,0,10"/>
                            <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png" 
                                   Width="220" Height="220" 
                                   Margin="0,50,0,10"/>
                            <TextBlock Text="OdontoNova"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- PANEL DERECHO -->
                    <Grid Grid.Column="1" Margin="0,10,0,-24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel 
                                    HorizontalAlignment="Center" Cursor="Hand"
 >
                            <TextBlock Text="Inicio de Sesión"
                                       FontSize="58"
                                       Foreground="#216CA2"
                                       Margin="0,0,0,40"
                                       TextAlignment="Center" FontFamily="Impact"/>

                            <TextBlock Text="Nombre de usuario" 
                                       Foreground="#1B5782"
                                       FontWeight="SemiBold"
                                       Margin="0,80,0,10"
                                       HorizontalAlignment="Center" 
                                       FontFamily="Tahoma" 
                                       FontSize="16" Cursor=""/>
                            <TextBox x:Name="txtUsuario"
                                     Height="35" 
                                     Padding="8"
                                     Background="White"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     Margin="0,0,0,15"
                                     FontFamily="Tahoma"
                                     FontSize="14"/>
                          
                            <TextBlock Text="Contraseña"
                                       Foreground="#1B5782" 
                                       FontWeight="SemiBold" 
                                       Margin="0,30,0,10" 
                                       HorizontalAlignment="Center" 
                                       FontFamily="Tahoma"
                                       FontSize="16"/>
                            <Grid Margin="0,0,0,10" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>

                                <!-- PasswordBox -->
                                <PasswordBox x:Name="txtContrasena"
                 Grid.Column="0"
                 Height="35"
                 Padding="8"
                 Background="White"
                 BorderBrush="#CBD5E1"
                 BorderThickness="1"
                 FontSize="14"
                />

                                <!-- TextBox visible (cuando se muestra la contraseña) -->
                                <TextBox x:Name="txtContrasenaVisible"
             Height="35" 
                Padding="8"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
              
                FontFamily="Tahoma"
                FontSize="14"
             Visibility="Collapsed"
             
             />

                                <!-- Botón ojito -->
                                <Button x:Name="Btn_MostrarContraseña"
            Grid.Column="1"
            Width="30" Height="30"
            Background="Transparent"
            BorderThickness="0"
            FontSize="18"
            Content="👁"
            Cursor="Hand"
            Click="Btn_MostrarContraseña_Click"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
                            </Grid>



                            <TextBlock Text="¿Olvidó su contraseña?" 
                                       FontSize="18"
                                       Foreground="#0B0F67"
                                       TextAlignment="Right"
                                       Cursor="Hand"
                                       Margin="0,0,0,20" HorizontalAlignment="Center" TextDecorations="Underline" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>

                            <!-- BOTÓN DE ACCEDER CON EFECTO -->
                            <Border Style="{StaticResource BotonHoverAnimado}"
        Margin="0,80,0,0"
        CornerRadius="12"
        Background="#2F80ED"
        SnapsToDevicePixels="True"
        HorizontalAlignment="Center">
                                <Button x:Name="btn_acceder"
            Content="Acceder"
            Width="160"
            Height="48"
            Background="Transparent"
            Foreground="White"
            BorderBrush="Transparent"
            Cursor="Hand"
            Click="btn_acceder_Click"
            FontFamily="Impact"
            FontSize="16"
            HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                Background="{TemplateBinding Background}"
                CornerRadius="12"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E6FDB"/>
                                                    <Setter TargetName="border" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black"
                                          BlurRadius="10"
                                          ShadowDepth="2"
                                          Opacity="0.4"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#175BB5"/>
                                                    <Setter TargetName="border" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#33000000" BlurRadius="8" ShadowDepth="1"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>

                                </Button>
                            </Border>


                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>

