<Window x:Class="OdontoNova.BuscarExpediente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White">

    <!-- ESTILO DE BOTÓN CON EFECTO -->
    <Window.Resources>
        <Style x:Key="BotonHoverAnimado" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="3,3"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.03" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.03" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Filtros -->
            <RowDefinition Height="*"/>
            <!-- Resultados -->
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="#2F80ED" Height="60" MouseDown="Header_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BOTÓN DE REGRESO -->
                <Border Style="{StaticResource BotonHoverAnimado}" Margin="10,0,0,0">
                    <Button 
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                        Click="btn_regresar_Click">
                        <Image x:Name="btn_regresar" Source="/Assets/Images/regresa.png" Stretch="Uniform"/>
                    </Button>
                </Border>

                <!-- TÍTULO + LOGO -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="EXPEDIENTE"
                               Foreground="White"
                               FontSize="40"
                               FontWeight="SemiBold"
                               FontFamily="Impact"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png"
                           Width="50" Height="50"
                           Margin="15,0,0,0"/>
                </StackPanel>

                <!-- BOTONES DE VENTANA -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5" HorizontalAlignment="Left" Width="72">
                    <Button Content="—" Width="36" Height="30"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="20"
                            Cursor="Hand" Click="Min_Click"/>
                    <Button Content="▭" Width="36" Height="30"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="20"
                            Cursor="Hand" Click="Max_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- FILTROS Y BÚSQUEDA -->
        <StackPanel Grid.Row="1" Margin="60,20,60,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Ícono -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Texto -->
                    <ColumnDefinition Width="2*"/>
                    <!-- ComboBox -->
                    <ColumnDefinition Width="3*"/>
                    <!-- TextBox -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Botón -->
                </Grid.ColumnDefinitions>

                <!-- Ícono -->
                <Image Grid.Column="0"
               Source="/Assets/Images/filtrar.png"
               Width="24" Height="24"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

                <!-- Texto -->
                <TextBlock Grid.Column="1"
                   Text="Filtro de búsqueda:"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#1B5782"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" FontFamily="Tahoma"/>

                <!-- ComboBox de estado -->
                <ComboBox Grid.Column="2"
                  Height="35"
                  FontSize="18"
                  Margin="0,0,50,0"
                  x:Name="cb_filtroBusqueda" FontFamily="Tahoma">
                </ComboBox>

                <!-- TextBox con placeholder simulado -->
                <!-- TextBox con placeholder simulado y sugerencias flotantes -->
                <!-- TextBox con placeholder simulado -->
                <Grid Grid.Column="3" Margin="0,0,10,0">
                    <TextBox x:Name="txt_Busqueda"
                         FontSize="18"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         TextChanged="txt_Busqueda_TextChanged" FontFamily="Tahoma"/>
                                        <TextBlock x:Name="txtPlaceholder"
                           Text="Buscar"
                           Foreground="#FF5E6268"
                           FontSize="16"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Visible" FontFamily="Segoe UI Emoji" FontWeight="Bold"/>
                </Grid>



                <!-- Popup flotante, fuera del Grid para no alterar el layout -->
                <Popup x:Name="popupSugerencias"
       Placement="Bottom"
       PlacementTarget="{Binding ElementName=txt_Busqueda}"
       StaysOpen="False"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       Opened="popupSugerencias_Opened">

                    <!-- Recursos del Popup -->
                    <Popup.Resources>
                        <!-- 👇 Primero definimos el suavizado -->
                        <QuadraticEase x:Key="SmoothEase" EasingMode="EaseOut"/>

                        <!-- 👇 Después definimos la animación -->
                        <Storyboard x:Key="popupOpenAnim">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25"
                             EasingFunction="{StaticResource SmoothEase}"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="-10" To="0"
                             Duration="0:0:0.25"
                             EasingFunction="{StaticResource SmoothEase}"/>
                        </Storyboard>
                    </Popup.Resources>

                    <Border Background="White"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,4,0,0"
            SnapsToDevicePixels="True"
            RenderTransformOrigin="0.5,0.0">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>

                        <ListBox x:Name="lbx_sugerencias"
                 Width="{Binding ActualWidth, ElementName=txt_Busqueda}"
                 MaxHeight="180"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="5"
                 MouseLeftButtonUp="lbx_sugerencias_MouseClick"
                 KeyDown="lbx_sugerencias_KeyDown"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Opacity="0">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="3"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#2E3A59"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                                    <Style.Triggers>
                                        <!-- Hover -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8F4FF"/>
                                            <Setter Property="Foreground" Value="#1E88E5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Color="#90CAF9"
                                                      Opacity="0.6"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>

                                        <!-- Seleccionado -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2196F3"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="15"
                                                      ShadowDepth="0"
                                                      Color="#1976D2"
                                                      Opacity="0.8"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Popup>


                <!-- Botón de búsqueda -->
                <Border Grid.Column="4"
                        Style="{StaticResource BotonHoverAnimado}"
                        Height="50"
                        Width="50"
                        Cursor="Hand">
                    <Button x:Name="btn_buscar"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="btn_buscar_Click">
                        <Image Source="/Assets/Images/buscar.png"
                               Stretch="Fill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    </Button>
                </Border>
            </Grid>
        </StackPanel>


        <!-- Resultados con scroll -->
        <Border Grid.Row="2"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="8"
                Background="#F9FAFB"
                Margin="40,20,40,20">
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10">
                <StackPanel x:Name="sp_contenedorBusqueda"
                            Orientation="Vertical"
                            Margin="0">
                    
                    <!-- Aquí se agregan los controles de usuario -->
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
