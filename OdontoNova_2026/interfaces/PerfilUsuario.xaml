<Window x:Class="OdontoNova.Interfaces.PerfilUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Height="515" Width="650">

    <Window.Resources>
        <!-- estilo limpio para el botón regresar-->
        <Style x:Key="BotonLimpio" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- Animacion del boton regresar-->
        <Style x:Key="AnimacionRegresar" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.25" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.25" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PopAnimacion" TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#33000000" BlurRadius="4" ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- estilo para botones de guardar-->
        <Style x:Key="EstiloAzulBoton" BasedOn="{StaticResource PopAnimacion}" TargetType="Button">
            <Setter Property="Background" Value="#2b6de0"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E6FDB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#175BB5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- estilo para botn de guardar datos editados -->
        <Style x:Key="EstiloBotonGuardar" BasedOn="{StaticResource PopAnimacion}" TargetType="Button">
            <Setter Property="Background" Value="#2b6de0"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#43A047"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2E7D32"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- estilo para boton de cancelar edicion -->
        <Style x:Key="EstiloBotonCancelar" BasedOn="{StaticResource PopAnimacion}" TargetType="Button">
            <Setter Property="Background" Value="#2b6de0"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E53935"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- estilos para los textbox -->
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#F1F5F9" BorderBrush="#2b6de0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2b6de0" CornerRadius="14,14,0,0" MouseDown="PerfilUsuario_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource AnimacionRegresar}" Margin="15,0,0,0" HorizontalAlignment="Left">
                        <Button x:Name="Btn_Regresar" Style="{StaticResource BotonLimpio}" Click="Btn_Regresar_Click" Cursor="Hand">
                            <Image Source="/Assets/Images/regresa.png" Stretch="Uniform" Width="30"/>
                        </Button>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="PERFIL" Foreground="White" FontSize="32" FontFamily="Impact" VerticalAlignment="Center"/>
                        <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png" Width="35" Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- fecha-->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="Fecha: " FontWeight="Bold" FontSize="14" Foreground="#1B5782" Margin="0,0,10,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="lb_Fecha" Text="00/00/0000" FontSize="12" Foreground="#FF788DA9" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
                <!-- contenedor de imagen -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0">

                    <Border Width="130" Height="130" CornerRadius="65" BorderBrush="#CCC" BorderThickness="1" Background="#EEE">
                        <Grid>
                            <Image x:Name="img_FotoUsuarioLectura" Stretch="UniformToFill" Width="130" Height="130"/>
                            <Image x:Name="img_FotoUsuarioEditable" Stretch="UniformToFill" Width="130" Height="130" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <!-- rol de usuario -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Rol: " FontWeight="Bold" FontSize="14" Foreground="#1B5782">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="lb_Rol" Text="TipoRol" FontSize="14" Foreground="#334155" FontWeight="Bold">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                    <!-- panel para cambiar foto o eliminar en modo edicion -->
                    <StackPanel x:Name="PanelBotonesFoto" Visibility="Collapsed" Margin="0,15,0,0">
                        <Button x:Name="Btn_CambiarFoto" Content="Cambiar Foto" Margin="0,5" Height="30" Background="#2b6de0" Foreground="White" Style="{StaticResource EstiloAzulBoton}" Click="Btn_CambiarFoto_Click"/>
                        <Button x:Name="Btn_EliminarFoto" Content="Eliminar Foto" Height="30" Background="#E53935" Foreground="White" Style="{StaticResource EstiloBotonCancelar}" Click="Btn_EliminarFoto_Click"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0,0,0">

                    <!-- panel para vista lectura -->
                    <Border x:Name="VistaSoloLectura" Background="White" CornerRadius="15" Padding="25" Visibility="Visible">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="DATOS DEL USUARIO" FontWeight="ExtraBold" Foreground="#2b6de0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Separator Background="#E2E8F0" Margin="0,0,0,15"/>

                            <StackPanel Margin="0,10">
                                <TextBlock Text="Usuario:" FontWeight="Bold" Foreground="#1B5782" FontSize="12"/>
                                <TextBlock x:Name="lb_Usuario" Text="usuario123" FontSize="16" Foreground="#334155" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Separator Background="#F1F5F9"/>
                            <StackPanel Margin="0,10">
                                <TextBlock Text="Correo:" FontWeight="Bold" Foreground="#1B5782" FontSize="12"/>
                                <TextBlock x:Name="lb_Correo" Text="correo@ejemplo.com" FontSize="16" Foreground="#334155" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Separator Background="#F1F5F9"/>
                            <StackPanel Margin="0,10">
                                <TextBlock Text="Contraseña:" FontWeight="Bold" Foreground="#1B5782" FontSize="12"/>
                                <TextBlock x:Name="lb_Contraseña" Text="••••••••" FontSize="16" Foreground="#334155" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Button x:Name="Btn_EditarPerfilGeneral" Content="✏️ Editar Perfil" Margin="0,20,0,0" Height="40" Background="#2b6de0" Foreground="White" FontWeight="Bold" Style="{StaticResource EstiloAzulBoton}" Click="Btn_EditarPerfilGeneral_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    <!-- panel para vista editable -->
                    <Border x:Name="VistaEditable" Background="White" CornerRadius="15" Padding="25" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="DATOS DEL USUARIO" FontWeight="ExtraBold" Foreground="#2b6de0" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Top">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Separator Background="#E2E8F0" Margin="0,0,0,15"/>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Usuario" FontSize="12" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txt_Usuario" Style="{StaticResource InputStyle}" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="Btn_EditarUsuario" Content="✎" Width="35" Height="35" Margin="5,0,0,0" Background="#2b6de0" Foreground="White" Style="{StaticResource EstiloAzulBoton}" Click="Btn_EditarUsuario_Click"/>
                                    <Button x:Name="Btn_GuardarUsuario" Content="💾" Width="35" Height="35" Margin="5,0,0,0" Visibility="Collapsed" Background="#43A047" Foreground="White" Style="{StaticResource EstiloBotonGuardar}" Click="Btn_GuardarUsuario_Click"/>
                                    <Button x:Name="Btn_CancelarUsuario" Content="✕" Width="35" Height="35" Margin="5,0,0,0" Visibility="Collapsed" Background="#E53935" Foreground="White" Style="{StaticResource EstiloBotonCancelar}"  Click="Btn_CancelarUsuario_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Correo" FontSize="12" Margin="0,0,0,3"/>
                                    <TextBox x:Name="txt_Correo" Style="{StaticResource InputStyle}" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="Btn_EditarCorreo" Content="✎" Width="35" Height="35" Margin="5,0,0,0" Background="#2b6de0" Foreground="White" Style="{StaticResource EstiloAzulBoton}"  Click="Btn_EditarCorreo_Click"/>
                                    <Button x:Name="Btn_GuardarCorreo" Content="💾" Width="35" Height="35" Margin="5,0,0,0" Visibility="Collapsed" Background="#43A047" Style="{StaticResource EstiloBotonGuardar}"  Foreground="White" Click="Btn_GuardarCorreo_Click"/>
                                    <Button x:Name="Btn_CancelarCorreo" Content="✕" Width="35" Height="35" Margin="5,0,0,0" Visibility="Collapsed" Background="#E53935" Foreground="White" Style="{StaticResource EstiloBotonCancelar}" Click="Btn_CancelarCorreo_Click"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Contraseña" FontSize="12" Margin="0,0,0,3"/>
                                    <Grid>
                                        <PasswordBox x:Name="txt_Contraseña" Style="{StaticResource InputStyle}" IsEnabled="False"/>
                                        <TextBox x:Name="txt_ContraseñaVisible" Style="{StaticResource InputStyle}" IsEnabled="False" Visibility="Collapsed"/>
                                        <Button x:Name="Btn_MostrarContra" Content="👁" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Click="Btn_MostrarContra_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="Btn_EditarContra" Content="✎" Width="35" Height="35" Margin="5,0,0,0" Background="#2b6de0" Foreground="White" Style="{StaticResource EstiloAzulBoton}" Click="Btn_EditarContra_Click"/>
                                    <Button x:Name="Btn_GuardarContra" Content="💾" Width="35" Height="35" Margin="5,0,0,0" Visibility="Collapsed" Background="#43A047" Foreground="White" Style="{StaticResource EstiloBotonGuardar}" Click="Btn_GuardarContra_Click"/>
                                    <Button x:Name="Btn_CancelarContra" Content="✕" Width="35" Height="35" Margin="5,0,0,0" Visibility="Collapsed" Background="#E53935" Foreground="White" Style="{StaticResource EstiloBotonCancelar}"  Click="Btn_CancelarContra_Click"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="PanelConfirmarContra" Visibility="Collapsed" Margin="0,5">
                                <TextBlock Text="Confirmar contraseña" FontSize="12" Margin="0,0,0,3"/>
                                <Grid>
                                    <PasswordBox x:Name="txt_ConfirmarContra" Style="{StaticResource InputStyle}"/>
                                    <TextBox x:Name="txt_ConfirmarContraVisible" Style="{StaticResource InputStyle}" Visibility="Collapsed"/>
                                    <Button x:Name="Btn_MostrarConfirmarContra" Content="👁" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Margin="0,0,5,0" Click="Btn_MostrarConfirmarContra_Click"/>
                                </Grid>
                            </StackPanel>
                            <!-- Botón para guardar datos editados -->
                            <Button x:Name="Btn_GuardarCambios" Content="Guardar Cambios" Margin="0,15,0,0" Height="40" Background="#FF61B910" Foreground="White" FontWeight="Bold" Style="{StaticResource EstiloBotonGuardar}" Click="Btn_GuardarCambios_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
