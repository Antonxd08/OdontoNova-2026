<Window x:Class="OdontoNova.ExpedientePaciente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White">

    <!-- ESTILO DE BOTÓN CON EFECTO -->
    <Window.Resources>
        <Style x:Key="BotonHoverAnimado" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         To="1.08" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         To="1.08" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                         To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                         To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- CONTENEDOR PRINCIPAL -->
    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- encabezado -->
            <Border Grid.Row="0" Background="#2F80ED" Height="60" MouseDown="Header_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- regresar -->
                    <Border Style="{StaticResource BotonHoverAnimado}" Margin="10,0,0,0">
                        <Button
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Cursor="Hand"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="btn_regresar_Click">
                            <Image x:Name="btn_regresar" Source="/Assets/Images/regresa.png" Stretch="Uniform"/>
                        </Button>
                    </Border>

                    <!-- titulo + icono -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="EXPEDIENTE"
                               Foreground="White"
                               FontSize="40"
                               FontWeight="SemiBold"
                               FontFamily="Impact"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                        <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png"
                           Width="48" Height="48"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"/>
                    </StackPanel>

                    <!-- botones de encabezado -->
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,5" HorizontalAlignment="Left" Width="72">
                        <Button Content="—" Width="36" Height="30"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="20"
                            Cursor="Hand" Click="Min_Click"/>
                        <Button Content="▭" Width="36" Height="30"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="20"
                            Cursor="Hand" Click="Max_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO CON SCROLL -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" Width="920" Margin="0,80,0,0">

                    <!-- CONTENEDOR AZUL -->
                    <Border BorderBrush="#2F80ED" BorderThickness="2" CornerRadius="8" Padding="20" Background="White" x:Name="ExpedienteContainer">
                        <StackPanel>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <!-- Zona izquierda -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Zona derecha -->
                                </Grid.ColumnDefinitions>

                                <!-- Contenedor izquierdo: ID -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="ID de expediente:"
                   Foreground="Black" FontWeight="Bold" FontSize="20"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtb_idExpediente"
                   Text="----" FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Contenedor derecho: Fecha -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Fecha de registro:"
                   Foreground="Black" FontWeight="Bold" FontSize="20"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="00/00/00" Name="txtb_fechaRegistro"
                   FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- ENCABEZADO CON LOGO, TÍTULO, FOTO Y ESTADO -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- logo y titulo -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Width="605" Margin="0,0,35,0">
                                    <Image Source="/Assets/Images/OdontoNova_Logo_fondoAzul.png"
                                           Width="186" Height="186"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" HorizontalAlignment="Left"/>
                                    <TextBlock Text="ODONTONOVA"
                                               FontSize="74"
                                               Foreground="#216CA2"
                                               FontFamily="Impact"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- FOTO DEL PACIENTE + ESTADO -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="#F9FAFB"
                                            Width="180"
                                            Height="180"
                                            Cursor="Hand" Margin="0,50,0,0" >
                                        <Grid>
                                            <!-- Imagen cargada -->
                                            <Image x:Name="imgFotoPaciente"
                                                   Stretch="Fill"
                                                   Visibility="Visible"/>

                                            <!-- Marcador de foto -->
                                            <StackPanel x:Name="placeholderFoto"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                               
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- ESTADO DEL PACIENTE -->
                                    <TextBlock 
                                     Text="Estado"
                                     FontSize="20"
                                        Foreground="Black"
                                        FontWeight="Bold"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtEstadoPaciente"
                                               Text="----"
                                               FontSize="20"
                                               Foreground="Black"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- CAMPOS -->
                            <!-- Nombre del paciente -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Nombre del paciente:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_nombrePaciente" Grid.Column="1" Text="----"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Apellidos -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Apellidos:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_apellidos" Grid.Column="1" Text="---"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Edad -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edad:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_edad" Grid.Column="1" Text="----"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Fecha de nacimiento -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fecha de nacimiento:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_fechaNacimiento" Grid.Column="1" Text="00/00/0000"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Género -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Género:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_genero" Grid.Column="1" Text="----"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Dirección -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Dirección:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_direccion" Grid.Column="1" Text="----------"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Número de teléfono -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Número de teléfono:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_numTelefono" Grid.Column="1" Text="----------"
                                           FontSize="18" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Antecedentes médicos -->
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Antecedentes médicos:"
                                           Foreground="Black" FontWeight="Bold" FontSize="20"
                                           VerticalAlignment="Top" Margin="0,0,20,0"/>
                                <TextBlock x:Name="txtb_antecedentes" Grid.Column="1" Text="-------"
                                           FontSize="18" TextWrapping="Wrap"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- BOTÓN REGISTRAR -->
                    <Border Style="{StaticResource BotonHoverAnimado}"
Margin="0,30,0,10"
CornerRadius="12"
Background="#276DCF"
SnapsToDevicePixels="True"
HorizontalAlignment="Center">
                        <Button x:Name="btn_exportarExpediente"
    Content="Registrar"
    Width="160"
    Height="48"
    Background="Transparent"
    Foreground="White"
    BorderBrush="Transparent"
    Cursor="Hand"
 
    FontFamily="Impact"
    FontSize="16"
    HorizontalAlignment="Left"
                                Click="btn_exportarExpediente_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
Background="{TemplateBinding Background}"
CornerRadius="12"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1E6FDB"/>
                                            <Setter TargetName="border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="Black"
                          BlurRadius="10"
                          ShadowDepth="2"
                          Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#175BB5"/>
                                            <Setter TargetName="border" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#33000000" BlurRadius="8" ShadowDepth="1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
